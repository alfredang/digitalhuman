# --- Core ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/digitalhuman"
NEXTAUTH_URL="http://localhost:3000"
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET="replace-me"
# 32-byte key, base64. Generate: openssl rand -base64 32
ENCRYPTION_KEY="replace-me-32-bytes-base64"

# --- First admin (created by `npm run seed`) ---
SEED_ADMIN_EMAIL="admin@tertiaryinfotech.com"
SEED_ADMIN_PASSWORD="changeme123"

# --- MiniMax (optional here; preferred to set via /admin Settings UI) ---
MINIMAX_API_KEY=""
MINIMAX_GROUP_ID=""
MINIMAX_BASE_URL="https://api.minimax.io/v1"
MINIMAX_CHAT_MODEL="MiniMax-M3"
MINIMAX_TTS_MODEL="speech-2.8-turbo"

# --- Avatar lip-sync (inference.sh) ---
INFERENCE_SH_TOKEN=""

# --- Storage (S3-compatible). Leave blank to use local ./public/uploads ---
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""
