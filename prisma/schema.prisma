// Digital Human Educator — data model
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum SourceType {
  PHOTO
  VIDEO
}

enum AvatarStatus {
  DRAFT
  READY
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         Role     @default(USER)
  avatars      Avatar[]
  createdAt    DateTime @default(now())
}

model Avatar {
  id            String         @id @default(cuid())
  name          String
  owner         User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId       String
  sourceType    SourceType     @default(PHOTO)
  sourceMediaUrl String?
  portraitUrl   String?
  voiceId       String?        // MiniMax cloned voice id (or preset voice)
  language      String         @default("English") // TTS language_boost + reply language
  persona       String         @default("You are a friendly, knowledgeable training course educator.")
  greeting      String         @default("Hi! I'm your course advisor. How can I help you today?")
  status        AvatarStatus   @default(DRAFT)
  embedKey      String         @unique @default(cuid())
  knowledge     KnowledgeDoc[]
  conversations Conversation[]
  createdAt     DateTime       @default(now())
}

model KnowledgeDoc {
  id         String   @id @default(cuid())
  avatar     Avatar   @relation(fields: [avatarId], references: [id], onDelete: Cascade)
  avatarId   String
  title      String
  content    String
  embedding  String? // JSON-encoded float[] vector (built-in vector store)
  chunkIndex Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([avatarId])
}

model Conversation {
  id        String    @id @default(cuid())
  avatar    Avatar    @relation(fields: [avatarId], references: [id], onDelete: Cascade)
  avatarId  String
  visitorId String?
  messages  Message[]
  createdAt DateTime  @default(now())

  @@index([avatarId])
}

model Message {
  id             String       @id @default(cuid())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  role           MessageRole
  text           String
  audioUrl       String?
  videoUrl       String?
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

// Encrypted app settings (API keys, model ids, base urls) — admin editable
model Setting {
  key            String   @id
  valueEncrypted String
  updatedAt      DateTime @updatedAt
}

// Editable CMS pages (About, Contact, Privacy, Terms) — managed in /admin/pages
model Page {
  slug      String   @id // about | contact | privacy | terms
  title     String
  content   String // HTML, authored by admin
  updatedAt DateTime @updatedAt
}

// Blog posts (each acts as a lead magnet with an enquiry CTA)
model Post {
  slug      String   @id
  title     String
  excerpt   String
  content   String // HTML, authored by admin
  industry  String? // e.g. Education, Retail
  coverImage String?
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, createdAt])
}

// Lead-magnet enquiries (e.g. "Request a Digital Human Demo")
model Lead {
  id        String   @id @default(cuid())
  name      String
  email     String
  company   String?
  phone     String?
  interest  String? // what they want demoed / message
  source    String   @default("digital-human-demo")
  status    String   @default("new") // new | contacted | closed
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model RenderJob {
  id        String   @id @default(cuid())
  type      String // "voice-clone" | "talking-clip"
  status    String   @default("pending") // pending | running | done | error
  payload   String // JSON
  resultUrl String?
  error     String?
  createdAt DateTime @default(now())
}
